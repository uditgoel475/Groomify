# Copy this file to `.env` and fill in real values, OR run `./scripts/generate-env.sh`
# to produce a `.env` with freshly-generated dev secrets.
#
# DO NOT commit `.env`. DO NOT use these placeholder values in any non-dev environment.

# --- Postgres ---
POSTGRES_DB=groomify
POSTGRES_USER=groomify
POSTGRES_PASSWORD=groomify-dev

# --- Host port the app is exposed on ---
GROOMIFY_PORT=8080

# --- Redis Commander UI (browse/inspect keys at http://localhost:${REDIS_COMMANDER_PORT}) ---
# Bound to 127.0.0.1 only by docker compose — dev/debug only, do not expose externally.
REDIS_COMMANDER_PORT=8081

# --- HS512 JWT signing secret. Must be >=64 bytes. ---
# Generate: openssl rand -base64 64 | tr -d '\n'
APP_JWT_SECRET=

# --- AES-GCM key for the JWT subject payload. Base64-encoded 16/24/32 bytes. ---
# Generate: openssl rand -base64 32
APP_AES_KEY=

# --- RSA keypair for refresh-token encryption. ---
# Generate the pair (single-line Base64):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER \
#     | openssl pkcs8 -topk8 -inform DER -outform DER -nocrypt \
#     | base64 | tr -d '\n'
# Then derive the public key from the private:
#   openssl rsa -in <(echo "$PRIV" | base64 -d) -inform DER -pubout -outform DER \
#     | base64 | tr -d '\n'
RSA_PUBLIC_KEY=
RSA_PRIVATE_KEY=

# --- CORS (comma-separated allowed origins; empty = block all) ---
GROOMIFY_CORS_ALLOWED_ORIGINS=

# --- Geonames account (postal-code lookups; sign up at https://www.geonames.org) ---
GEONAMES_USERNAME=your-geonames-username
